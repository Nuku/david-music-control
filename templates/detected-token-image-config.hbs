<form class="standard-form">
	<div class="form-group">
		<label>Detected Token Image</label>
		<div class="form-fields">
			<file-picker name="detectedTokenImage" type="imagevideo" value="{{detectedTokenImage}}"></file-picker>
			<button type="button" data-action="clear-image">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<p class="hint">This image appears beneath PF2e's normal tint, fade, and concentric detection rings when Use Custom Image for Detected Tokens is enabled.</p>
	</div>

	<footer class="sheet-footer flexrow">
		<button type="submit">
			<i class="fas fa-save"></i> Save
		</button>
	</footer>
</form>
