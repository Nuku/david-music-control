<form class="dhb-config-form" autocomplete="off">
	<div class="form-group">
		<label for="dhb-enable-sounds">Enable Sounds</label>
		<div class="form-fields">
			<input type="checkbox" id="dhb-enable-sounds" name="enableSounds" {{checked enableSounds}} />
		</div>
		<p class="notes">Play a sound effect whenever a health bar is displayed.</p>
	</div>

	<hr />

	<div class="form-group">
		<label>Damage Sound</label>
		<div class="form-fields dhb-file-row">
			<input type="text" name="damageSound" value="{{damageSound}}" placeholder="Path to audio file..." />
			<button type="button" class="dhb-btn-browse" data-target="damageSound" title="Browse files">
				<i class="fas fa-folder-open"></i>
			</button>
			<button type="button" class="dhb-btn-test" data-target="damageSound" title="Test sound">
				<i class="fas fa-play"></i>
			</button>
		</div>
		<p class="notes">Played when a token loses HP.</p>
	</div>

	<div class="form-group">
		<label>Heal Sound</label>
		<div class="form-fields dhb-file-row">
			<input type="text" name="healSound" value="{{healSound}}" placeholder="Path to audio file..." />
			<button type="button" class="dhb-btn-browse" data-target="healSound" title="Browse files">
				<i class="fas fa-folder-open"></i>
			</button>
			<button type="button" class="dhb-btn-test" data-target="healSound" title="Test sound">
				<i class="fas fa-play"></i>
			</button>
		</div>
		<p class="notes">Played when a token gains HP.</p>
	</div>

	<div class="form-group">
		<label>Volume <span class="dhb-vol-label">{{volumePct}}%</span></label>
		<div class="form-fields">
			<input type="range" name="soundVolume" min="0" max="1" step="0.05" value="{{soundVolume}}" />
		</div>
	</div>
</form>
