<form autocomplete="off">
	<div class="form-group">
		<label>Villain Point Dread Sound</label>
		<div class="form-fields dhb-file-row">
			<file-picker
				name="villainPointNoticeSound"
				type="audio"
				value="{{villainPointNoticeSound}}"
			></file-picker>
			<button type="button" data-action="clear-audio" title="Clear sound">
				<i class="fas fa-times"></i>
			</button>
			<button type="button" data-action="test-audio" title="Test sound">
				<i class="fas fa-play"></i>
			</button>
		</div>
		<p class="notes">Played for all connected users when villain points are gained or spent.</p>
	</div>

	<div class="form-group">
		<label>Volume <span class="dmc-volume-label">{{volumePct}}%</span></label>
		<div class="form-fields">
			<input
				type="range"
				name="villainPointNoticeVolume"
				min="0"
				max="1"
				step="0.05"
				value="{{villainPointNoticeVolume}}"
			/>
		</div>
	</div>

	<footer class="sheet-footer flexrow">
		<button type="submit">
			<i class="fas fa-save"></i> Save
		</button>
	</footer>
</form>
