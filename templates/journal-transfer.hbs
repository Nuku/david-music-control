<form class="standard-form dmc-journal-transfer-form">
	<section class="dmc-transfer-section">
		<header>
			<h2>File Pipeline</h2>
			<p>Use the original file-based export/import flow.</p>
		</header>
		<div class="dmc-transfer-actions">
			<button type="button" data-action="export-file">
				<i class="fas fa-file-export"></i> Export JSON File
			</button>
			<button type="button" data-action="import-file">
				<i class="fas fa-file-import"></i> Import JSON File
			</button>
		</div>
	</section>

	<section class="dmc-transfer-section">
		<header>
			<h2>Copy / Paste Pipeline</h2>
			<p>Copy the current config as JSON or paste edited JSON here and apply it directly.</p>
		</header>
		<div class="dmc-transfer-actions">
			<button type="button" data-action="refresh-json">
				<i class="fas fa-rotate"></i> Refresh JSON
			</button>
			<button type="button" data-action="copy-json">
				<i class="fas fa-copy"></i> Copy JSON
			</button>
			<button type="submit">
				<i class="fas fa-paste"></i> Apply Pasted JSON
			</button>
		</div>
		<label class="dmc-transfer-textarea">
			<span>Music Config JSON</span>
			<textarea name="musicJson" spellcheck="false">{{json}}</textarea>
		</label>
	</section>

	<section class="dmc-transfer-section">
		<header>
			<h2>Journal Text to Subsystem Export</h2>
			<p>Paste plain text copied from a journal. The parser builds an influence subsystem export and downloads it as JSON.</p>
		</header>
		<div class="dmc-transfer-actions">
			<button type="button" data-action="preview-journal-json">
				<i class="fas fa-eye"></i> Preview Export JSON
			</button>
			<button type="button" data-action="export-journal-text">
				<i class="fas fa-download"></i> Download Subsystem Export
			</button>
		</div>
		<label class="dmc-transfer-textarea">
			<span>Journal Text</span>
			<textarea name="journalText" spellcheck="false">{{journalText}}</textarea>
		</label>
		<label class="dmc-transfer-textarea">
			<span>Generated Export JSON</span>
			<textarea name="journalJson" spellcheck="false" readonly></textarea>
		</label>
	</section>
</form>
