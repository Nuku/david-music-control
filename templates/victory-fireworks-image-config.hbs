<form class="standard-form">
	<div class="form-group">
		<label>Victory Fireworks Image</label>
		<div class="form-fields">
			<file-picker name="victoryFireworksTexture" type="imagevideo" value="{{victoryFireworksTexture}}"></file-picker>
			<button type="button" data-action="clear-image">
				<i class="fas fa-times"></i>
			</button>
		</div>
		<p class="hint">Optional custom particle image for victory fireworks. Leave blank to use the default star. Keep the image small, ideally around 32x32 or 64x64.</p>
	</div>

	<footer class="sheet-footer flexrow">
		<button type="submit">
			<i class="fas fa-save"></i> Save
		</button>
	</footer>
</form>
